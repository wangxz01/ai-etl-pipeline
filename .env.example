# =============================================================================
# AI ETL Pipeline — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# =============================================================================

# --- LLM Provider (DeepSeek via OpenAI-compatible endpoint) ---
# API key for the LLM provider
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Base URL for the OpenAI-compatible API endpoint
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Model identifier for long-chain reasoning tasks
DEEPSEEK_MODEL=deepseek-reasoner

# Model identifier for code generation and review tasks
DEEPSEEK_CODER_MODEL=deepseek-coder

# Maximum tokens for completion responses
DEEPSEEK_MAX_TOKENS=8192

# Temperature for generation (0.0 = deterministic, 1.0 = creative)
DEEPSEEK_TEMPERATURE=0.1

# --- Database ---
# Source database connection string
SOURCE_DB_URL=postgresql://user:password@localhost:5432/source_db

# Target/warehouse database connection string
TARGET_DB_URL=postgresql://user:password@localhost:5432/warehouse_db

# Connection pool size
DB_POOL_SIZE=10

# --- Pipeline ---
# Maximum retry attempts for auto-fix loops
MAX_RETRY_ATTEMPTS=3

# Enable verbose logging
LOG_LEVEL=INFO

# Output directory for generated code and artifacts
OUTPUT_DIR=./output

# --- Airflow ---
# Airflow DAGs directory (for generated DAGs)
AIRFLOW_DAGS_DIR=./dags

# --- Data Validation ---
# Maximum acceptable null rate (0.0–1.0)
MAX_NULL_RATE=0.05

# Maximum acceptable distribution shift (KS statistic, 0.0–1.0)
MAX_DISTRIBUTION_SHIFT=0.1

# Row count tolerance as a fraction (e.g., 0.01 = 1%)
ROW_COUNT_TOLERANCE=0.01
